{
  "name": "multi-messenger",
  "version": "1.1.0",
  "description": "All-in-one desktop messenger (Telegram, Discord, Twitter/X, Facebook) - free, open source, Rambox-like",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "You",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yourname.multimessenger",
    "productName": "Multi Messenger",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "catalog.json",
      "renderer/**/*"
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
