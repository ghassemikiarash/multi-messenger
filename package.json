{
  "name": "multi-messenger",
  "version": "1.2.0",
  "description": "All-in-one desktop messenger — free, open source",
  "main": "main.js",
  "author": "Kiarash Ghassemi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ghassemikiarash.multimessenger",
    "productName": "Multi Messenger",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "catalog.json",
      "renderer/**/*",
      "icons/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Multi Messenger Setup ${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "ghassemikiarash",
      "repo": "multi-messenger"
    }
  }
}
